{# Headline status badge; must stay in sync with components.ts::headlineBadge
   (both look their meaning up in STATUS_COPY -- render.py registers it as a
   Jinja global, components.ts::HEADLINE_COPY is its hand-kept TS twin). The
   popover itself is components.ts::bindTips, bound page-wide; a badge only
   has to carry data-tip and the button contract (see the chip macro below). #}
{% macro headline_badge(h) %}<span class="badge st st-{{ h | replace("_", "-") }}" role="button" tabindex="0" data-tip="{{ STATUS_COPY[h] }}">{{ h | replace("_", " ") }}</span>{% endmacro %}

{# A filter chip. It is a span, not a button, so the button role and the pressed
   state have to be spelled out here; components.ts::toggleChip keeps aria-pressed
   in sync from then on, and bindActivation gives it Enter/Space. `attr` is the
   dataset key the page's handler reads ("f" for the method/change filters, "st"
   for the status group). A "st" chip's value is a headline name, so its meaning
   is the same STATUS_COPY lookup the badge above uses -- "f" chips are feature
   filters with no single-status meaning, so they get no tip. #}
{% macro chip(label, attr, value, state="", on=false) -%}
<span class="chip{{ " " ~ state if state }}{{ " on" if on }}" data-{{ attr }}="{{ value }}"
  role="button" tabindex="0" aria-pressed="{{ "true" if on else "false" }}"{% if attr == "st" %} data-tip="{{ STATUS_COPY[value] }}"{% endif %}>{{ label }}</span>
{%- endmacro %}

{# The toolbar search box: the label's only content is a decorative magnifier, so
   the input carries its own name. #}
{% macro search_box(id, placeholder, label) -%}
<label class="search">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg>
  <input id="{{ id }}" type="text" placeholder="{{ placeholder }}" autocomplete="off" aria-label="{{ label }}">
</label>
{%- endmacro %}

{# The shared-timeline legend and panel (timeline.ts renders into #cmp; the tip is
   a sibling of the panel, not a child: .cmp clips its own overflow). `read_hint`
   names what one pointer position reads -- providers on the model page, endpoints
   on the provider page. #}
{% macro timeline_panel(read_hint) -%}
<div class="legend" id="cmpLegend">
  <span class="k"><i style="background:var(--accent)"></i> LT change</span>
  <span class="k"><i style="background:var(--b3it)"></i> B3IT change</span>
  <span class="k" style="color:var(--text-dim)">line = drift from baseline · dot height = how far it moved</span>
  <span class="k" style="color:var(--text-dim)">{{ read_hint }}</span>
</div>
<div class="chartbox">
  <div class="cmp" id="cmp"></div>
  <div class="chart-tip" id="cmptip" hidden></div>
</div>
{%- endmacro %}

{# A label with a tap/click/focus-activated explanation, via the same data-tip +
   bindTips mechanism chart strips use (components.ts::stripTip/bindTips) -- a
   bare title= only reaches desktop hover, never a touch screen. The button
   carries the full text as its aria-label since the caption bindTips writes on
   activation is aria-hidden (screen readers already have it from here). #}
{% macro info_label(label, tip) -%}
<span class="info-label">{{ label }} <button type="button" class="info-btn" data-tip="{{ tip }}" aria-label="{{ tip }}">?</button></span>
{%- endmacro %}

{# Logos of the institutions behind the project; shared by the front page and About. #}
{% macro affiliations() %}
<div class="affil" aria-label="Affiliations">
  {% for slug, name, ext, url in [('inria', 'Inria', 'svg', 'https://www.inria.fr/'), ('irisa', 'IRISA', 'png', 'https://www.irisa.fr/'), ('cnrs', 'CNRS', 'svg', 'https://www.cnrs.fr/')] %}
  <a href="{{ url }}" target="_blank" rel="noopener"><img src="logos/{{ slug }}.{{ ext }}" alt="{{ name }}"></a>
  {% endfor %}
</div>
{% endmacro %}

{# The Cite pill opens the site-wide #citeDialog (base.html.j2). Icon: Lucide
   message-square-quote, filled, as on tchauvin.com. #}
{% macro cite_pill() -%}
<button type="button" class="cite-pill" aria-haspopup="dialog" aria-controls="citeDialog">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z" fill="currentColor"/><path d="M14 14a2 2 0 0 0 2-2V8h-2M8 14a2 2 0 0 0 2-2V8H8" fill="none" stroke="var(--bg)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  Cite
</button>
{%- endmacro %}

{# A click-to-copy box: whatever is inside .cite-copyable goes to the clipboard.
   The status corner holds both icons; .is-copied (base.html.j2) swaps them. #}
{% macro cite_box(label) %}
<div class="cite-box" role="button" tabindex="0" aria-label="Copy {{ label }}">
  <span class="cite-box-status" aria-hidden="true">
    <svg class="i-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
    <svg class="i-done" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    <span class="i-label">Copied</span>
  </span>
  <div class="cite-copyable">{{ caller() }}</div>
</div>
{% endmacro %}

{# The modal behind every Cite pill: both papers as plain text, both as BibTeX. #}
{% macro cite_dialog() %}
<dialog id="citeDialog" class="cite-dialog" aria-label="Cite TrackLLM">
  <button type="button" class="cite-dialog-close" aria-label="Close">&times;</button>
  {% call cite_box("citations") %}{% for p in PAPERS.values() %}<p>{{ p.plain }}</p>
{% endfor %}{% endcall %}
  {% call cite_box("BibTeX") %}<pre>{{ PAPERS.values() | map(attribute="bibtex") | join("\n\n") }}</pre>{% endcall %}
</dialog>
{% endmacro %}
