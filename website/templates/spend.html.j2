{% extends "base.html.j2" %}
{% from "_macros.html.j2" import info_label %}
{% block title %}Spend | TrackLLM{% endblock %}
{% block content %}
<div class="wrap">
  <div class="crumb">
    <a href="index.html">Home</a><span class="sep">/</span>
    <span>Spend</span>
  </div>
  <div class="head">
    <div><h1>API Spend</h1></div>
  </div>
</div>

<main class="wrap">
  <section class="block">
    <div class="sec-head"><h2>Cumulative by group</h2></div>
    <div class="panel">
      {% if spend.cumulative %}
      <div class="tblwrap">
        <table class="changes-tbl">
          <thead><tr><th scope="col">Group</th><th scope="col" class="r">Cost (USD)</th></tr></thead>
          <tbody>
          {% for group, cost in spend.cumulative.items() %}
            <tr><td>{% if group == "vetting" %}{{ info_label(spend.group_label[group], vetting_tip) }}{% else %}{{ spend.group_label[group] }}{% endif %}</td><td class="r num">${{ cost|fmt_cost }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}<p class="no-data">No spend data yet.</p>{% endif %}
    </div>
  </section>

  <section class="block">
    <div class="sec-head"><h2>Daily spend</h2></div>
    <div class="panel">
      <div id="spend-chart"></div>
    </div>
  </section>

  <section class="block">
    <div class="sec-head"><h2>By endpoint</h2></div>
    <div class="panel">
      {% if spend.by_endpoint %}
      <div class="tblwrap">
      <table class="changes-tbl">
        <thead>
          <tr>
            <th scope="col">Endpoint</th>
            {% for g in spend.group_order %}<th scope="col" class="r">{% if g == "vetting" %}{{ info_label(spend.group_label[g], vetting_tip) }}{% else %}{{ spend.group_label[g] }}{% endif %}</th>{% endfor %}
            <th scope="col" class="r">Total</th>
          </tr>
        </thead>
        <tbody>
        {% for ep in spend.by_endpoint %}
          <tr>
            {# spend covers every slug we were billed for, including discovery probes
               and endpoints with no series -- neither of which has a page. Never the
               slug itself as visible text (only as the URL) -- ep.name is the
               human-readable "model @ provider" form, or the slug as a last resort
               when no registry can name it (see build_endpoint_names). #}
            <td>{% if ep.slug in tracked %}<a href="endpoints/{{ ep.slug }}.html">{{ ep.name }}</a>
              {%- else %}<span class="untracked">{{ ep.name }}</span>{% endif %}</td>
            {% for g in spend.group_order %}
            <td class="r num">{% if g in ep.groups %}${{ ep.groups[g]|fmt_cost }}{% else %}—{% endif %}</td>
            {% endfor %}
            <td class="r num">${{ ep.total|fmt_cost }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      </div>
      {% else %}<p class="no-data">No spend data yet.</p>{% endif %}
    </div>
  </section>
</main>
{% endblock %}

{% block scripts %}
    <script type="module" src="js/spend.js"></script>
{% endblock %}
