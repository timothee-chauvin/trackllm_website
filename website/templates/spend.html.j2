{% extends "base.html.j2" %}
{% block title %}Spend | TrackLLM{% endblock %}
{% block content %}
<div class="wrap">
  <div class="crumb">
    <a href="index.html">Home</a><span class="sep">/</span>
    <span>Spend</span>
  </div>
  <div class="head">
    <div><h1>API Spend</h1></div>
  </div>
</div>

<main class="wrap">
  <section class="block">
    <div class="sec-head"><h2>Cumulative by group</h2></div>
    <div class="panel">
      {% if spend.cumulative %}
      <table class="changes-tbl">
        <thead><tr><th scope="col">Group</th><th scope="col" class="r">Cost (USD)</th></tr></thead>
        <tbody>
        {% for group, cost in spend.cumulative.items() %}
          <tr><td>{{ group }}</td><td class="r num">${{ "%.4f"|format(cost) }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      {% else %}<p class="no-data">No spend data yet.</p>{% endif %}
    </div>
  </section>

  <section class="block">
    <div class="sec-head"><h2>Daily spend</h2></div>
    <div class="panel">
      <div id="spend-chart"></div>
    </div>
  </section>

  <section class="block">
    <div class="sec-head"><h2>By endpoint</h2></div>
    <div class="panel">
      {% if spend.by_endpoint %}
      <table class="changes-tbl">
        <thead>
          <tr>
            <th scope="col">Endpoint</th>
            {% for g in spend.group_order %}<th scope="col" class="r">{{ g }}</th>{% endfor %}
            <th scope="col" class="r">Total</th>
          </tr>
        </thead>
        <tbody>
        {% for ep in spend.by_endpoint %}
          <tr>
            {# spend covers every slug we were billed for, including discovery probes
               and endpoints with no series -- neither of which has a page #}
            <td>{% if ep.slug in tracked %}<a href="endpoints/{{ ep.slug }}.html">{{ ep.slug }}</a>
              {%- else %}<span class="untracked">{{ ep.slug }}</span>{% endif %}</td>
            {% for g in spend.group_order %}
            <td class="r num">{% if g in ep.groups %}${{ "%.4f"|format(ep.groups[g]) }}{% else %}—{% endif %}</td>
            {% endfor %}
            <td class="r num">${{ "%.4f"|format(ep.total) }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      {% else %}<p class="no-data">No spend data yet.</p>{% endif %}
    </div>
  </section>
</main>
{% endblock %}

{% block scripts %}
    <script type="module" src="js/spend.js"></script>
{% endblock %}
