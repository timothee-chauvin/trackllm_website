{% extends "base.html.j2" %}
{% from "_macros.html.j2" import chip, search_box %}

{% block title %}Changes | TrackLLM{% endblock %}

{% block content %}
<div class="wrap">
  <div class="head">
    <div>
      <h1>Detected changes</h1>
      <p class="lede" id="lede"></p>
      <div class="summary" id="summary"></div>
    </div>
  </div>
</div>

<main class="wrap">
  <section class="block">
    <div class="sec-head">
      <h2>Most-changed endpoints</h2>
      <span class="hint">the <a href="endpoints.html">endpoint directory</a> sorts the same field</span>
    </div>
    <div class="board" id="topEndpoints"></div>
  </section>

  <section class="block">
    <div class="sec-head"><h2>Log</h2><span class="hint" id="logCount"></span></div>
    <div class="toolbar">
      {{ search_box("q", "Search model, provider, or org…", "Search changes by model, provider, or org") }}
      <div class="chips" id="chips">
        {{ chip("LT", "f", "lt") }}
        {{ chip("B3IT", "f", "b3it") }}
        {{ chip("Last 90 days", "f", "recent") }}
        {{ chip("Large drift", "f", "big") }}
      </div>
    </div>
    <div class="feed" id="log"></div>
  </section>
</main>

<div class="note">Magnitude is the level shift across the change, the number its detector gated on — for LT the mean drift over the 7 days after minus the 7 days before, in nats; for B3IT the total-variation shift against the epoch's reference.</div>
{% endblock %}

{% block scripts %}
    <script type="module" src="js/changes.js?v={{ ASSET_V }}"></script>
{% endblock %}
