{% extends "base.html.j2" %}
{% from "_macros.html.j2" import headline_badge, subscribe_icon, brand_title %}

{% block title %}{{ model }} @ {{ provider }} | TrackLLM{% endblock %}

{% block content %}
<div class="wrap">
  <div class="head">
    <div>
      {# every name here is a page: the company that trained the model, the model, the company serving it #}
      <h1><a class="org" href="{{ nav_prefix }}orgs/{{ org_slug }}.html">{{ org }}</a>/{% if model_slug %}<a href="{{ nav_prefix }}models/{{ model_slug }}.html">{{ model_name }}</a>{% else %}{{ model_name }}{% endif %} {{ subscribe_icon(machine, nav_prefix) }}</h1>
      {# a provider without tracked endpoints has no page, so its name is not a link #}
      <div class="prov">Served by {% if provider_has_page %}<a href="{{ nav_prefix }}providers/{{ provider_slug }}.html">{{ brand_title(brand, nav_prefix) }}</a>{% else %}{{ brand_title(brand, nav_prefix) }}{% endif %}{% if variant %} ({{ variant }}){% endif %}</div>
      <div class="badges">{% for m in methods %}<span class="badge {{ m|lower }}">{{ m|lower }}</span>{% endfor %}{% if not methods %}{{ headline_badge(status.headline) }}{% endif %}</div>
    </div>
    {% if methods %}<div class="statuscard" id="statuscard"></div>{% endif %}
  </div>
  {# a model with no tracked providers, or a provider with no page, has nothing worth
     crosslinking here -- omit that line (or the whole box) rather than show a "0" #}
  {% set show_model_line = model_slug and n_providers > 0 %}
  {% if show_model_line or provider_has_page %}
  <div class="compare">
    {% if show_model_line %}<p><a href="{{ nav_prefix }}models/{{ model_slug }}.html">{{ model_name }}</a> is served by <a href="{{ nav_prefix }}models/{{ model_slug }}.html">{{ n_providers }} provider{{ "s" if n_providers != 1 else "" }}</a>.</p>{% endif %}
    {% if provider_has_page %}<p><a href="{{ nav_prefix }}providers/{{ provider_slug }}.html">{{ provider_base }}</a> serves <a href="{{ nav_prefix }}providers/{{ provider_slug }}.html">{{ n_models }} model{{ "s" if n_models != 1 else "" }}</a>.</p>{% endif %}
  </div>
  {% endif %}
</div>

<main class="wrap">
  <section class="block">
    <div class="sec-head"><h2>Tracking status</h2></div>
    <div class="panel status-methods">
      <div class="ms"><span class="badge lt">LT</span><span class="ms-body"><b class="st-name">{{ status.lt | replace("_", " ") | replace(":", " · ") }}</b> — {{ status.ltCopy }}{% if status.ltDetail %} <span class="ms-detail">({{ status.ltDetail }})</span>{% endif %}</span></div>
      <div class="ms"><span class="badge b3it">B3IT</span><span class="ms-body"><b class="st-name">{{ status.bi | replace("_", " ") | replace(":", " · ") }}</b> — {{ status.biCopy }}{% if status.biDetail %} <span class="ms-detail">({{ status.biDetail }})</span>{% endif %}</span></div>
    </div>
  </section>

  {% if methods %}
  <section class="block">
    <div class="sec-head"><h2>Drift from baseline</h2></div>
    <p class="sec-desc">Both signals measure how far this endpoint's behavior has moved from its <b>reference period</b>. <span class="lt">LT</span> tracks the average change in the returned tokens' log-probabilities (nats); <span class="b3">B3IT</span> tracks the total-variation distance of the border-input votes (0–1). Both should ideally be as close to 0 as possible. Dashed lines mark published changes, labeled with the <b>level shift</b> across them: for LT the mean drift over the 7 days after minus the 7 days before; for B3IT the total-variation shift its detector measured.</p>
    <div class="panel">
      {# the tip is a sibling of the chart, not a child: every redraw replaces #mainchart's contents #}
      <div class="chartbox">
        <div class="chartwrap chart" id="mainchart"></div>
        <div class="chart-tip" id="charttip" hidden></div>
      </div>
      <div class="footnote" id="footnote"></div>
    </div>
  </section>

  {# Rendered only with changes to list: the section is decided here, in the
     static HTML, so an unchanged endpoint never ships an empty table for a reader
     without scripts. #}
  {% if manifest.changes.lt or manifest.changes.b3it %}
  <section class="block" id="changesSection">
    <div class="sec-head"><h2>Detected changes</h2></div>
    <div class="panel">
      <div class="tblwrap">
        <table class="changes-tbl">
          <thead><tr><th scope="col">Date</th><th scope="col">Method</th><th scope="col" class="r">Level shift</th></tr></thead>
          <tbody id="changerows"></tbody>
        </table>
      </div>
    </div>
  </section>
  {% endif %}
  {% elif meta %}
  <section class="block">
    <div class="sec-head"><h2>Endpoint details</h2><span class="hint">from the OpenRouter catalog snapshot</span></div>
    <div class="panel meta-grid">
      <div><div class="k">Pricing (per Mtok)</div><div class="v">{% if meta.free %}Free{% else %}${{ meta.cost[0]|fmt_price }} in · ${{ meta.cost[1]|fmt_price }} out{% endif %}</div></div>
      <div><div class="k">Listed since</div><div class="v">{{ meta.created[:10] if meta.created else "—" }}</div></div>
      <div><div class="k">Claims temperature</div><div class="v">{{ "unknown" if meta.supports_temperature is none else ("yes" if meta.supports_temperature else "no") }}</div></div>
      <div><div class="k">Claims logprobs</div><div class="v">{{ "unknown" if meta.supports_logprobs is none else ("yes" if meta.supports_logprobs else "no") }}</div></div>
    </div>
  </section>
  {% endif %}

  {% if spend %}
  <section class="block">
    <div class="sec-head"><h2>Spend</h2><span class="hint">what OpenRouter billed for tracking this endpoint. Only tracked since {{ spend.since }}</span></div>
    <div class="panel">
      <div class="spend-stats">
        <div><div class="k">Total to date</div><div class="v">${{ spend.total|fmt_cost }}</div></div>
        <div><div class="k">Last 30 days</div><div class="v">${{ spend.last_30d|fmt_cost }}</div></div>
        <div><div class="k">Queries</div><div class="v">{{ "{:,}".format(spend.n_queries) }}</div></div>
      </div>
      {% if spend.total > 0 %}
      <div class="spend-bar" aria-hidden="true">
        {%- for g, cost in spend.groups.items() if cost > 0 %}<i class="{{ g }}" style="width:{{ "%.2f"|format(cost / spend.total * 100) }}%"></i>{% endfor -%}
      </div>
      <ul class="spend-legend">
        {% for g, cost in spend.groups.items() %}
        <li><i class="{{ g }}"></i>{{ group_label[g] }}<span class="num">${{ cost|fmt_cost }}{% set pct = cost / spend.total * 100 %}<span class="pct">{{ "<1%" if 0 < pct < 0.5 else "%.0f%%"|format(pct) }}</span></span></li>
        {% endfor %}
      </ul>
      {% endif %}
      <div class="footnote"><b>Vetting</b> is the one-off probe that checks the endpoint's billed cost against its advertised price. <b>B3IT (onboarding)</b> is the initial border-input search; <b>B3IT (monitoring)</b> and <b>LT</b> are the recurring daily checks.</div>
    </div>
  </section>
  {% endif %}

</main>
{% endblock %}

{% block scripts %}
    <script type="application/json" id="manifest">{{ manifest | tojson }}</script>
    {% if methods %}<script type="module" src="../js/endpoint.js?v={{ ASSET_V }}"></script>
    {% else %}{# untracked: only the server-rendered headline badge needs the popover #}
    <script type="module" src="../js/tips.js?v={{ ASSET_V }}"></script>{% endif %}
{% endblock %}
