{% set nav_prefix = nav_prefix | default('') %}
{% from "_macros.html.j2" import cite_dialog %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}TrackLLM{% endblock %}</title>
    <script>
    (function () {
        var stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') document.documentElement.dataset.theme = stored;
    })();
    </script>
    <link rel="icon" href="{{ nav_prefix }}favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="{{ css_path }}">
    {# machine access (machine.py): the md twin and the feed of this page #}
    <link rel="alternate" type="text/markdown" href="{{ nav_prefix }}{{ machine.md }}">
    {% if machine.feed %}<link rel="alternate" type="application/atom+xml" title="TrackLLM changes" href="{{ nav_prefix }}{{ machine.feed }}">{% endif %}
</head>
<body class="{{ body_class }}">
    <nav class="nav">
        <a class="brand" href="{{ nav_prefix }}index.html">
            <span class="glyph"><svg viewBox="0 0 24 24" fill="none" stroke="#0B0F14" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h4l2-7 4 14 2-7h8"/></svg></span>
            <span class="name">Track<b>LLM</b></span>
        </a>
        {# body_class already names the page every template is rendered as, so it is
           what says which nav link is the current one. #}
        <div class="nav-links">
            {% for page, label in [('changes', 'Changes'), ('methodology', 'Methodology')] %}
            <a href="{{ nav_prefix }}{{ page }}.html"{% if body_class == page %} class="active" aria-current="page"{% endif %}>{{ label }}</a>
            {% endfor %}
            <a href="https://github.com/timothee-chauvin/trackllm_website" target="_blank" rel="noopener">GitHub</a>
            <a href="{{ nav_prefix }}about.html"{% if body_class == 'about' %} class="active" aria-current="page"{% endif %}>About</a>
        </div>
        <div class="nav-right">
            <button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle color theme"></button>
        </div>
    </nav>
    <div class="container">
        {# Machine access bar (machine.py). The links are visible text on purpose:
           HTML-to-text converters -- what agents read -- drop attributes, so a
           <link rel=alternate> alone never reaches them. #}
        <div class="wrap machine-bar">
            <button class="copy-pill" type="button" aria-label="Copy this page as Markdown for an LLM"
                data-src="{{ nav_prefix }}{{ machine.md }}" data-goatcounter-click="copy/{{ machine.md }}">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span class="copy-pill-label">Copy for LLM</span>
            </button>
            <span class="machine-links">AI agents: read <a href="{{ nav_prefix }}{{ machine.md }}">{{ machine.md }}</a> instead of this page
              {% if machine.feed %}· <a href="{{ nav_prefix }}{{ machine.feed }}" type="application/atom+xml" data-goatcounter-click="subscribe/{{ machine.scope }}">Subscribe (Atom)</a>{% endif %}
              {% for j in machine.json %} · <a href="{{ nav_prefix }}{{ j }}">JSON{{ "" if loop.length == 1 else " " ~ loop.index }}</a>{% endfor %}
              · <a href="{{ nav_prefix }}index.html#machine">about</a></span>
        </div>
        {% block content %}{% endblock %}

        <footer class="site">
            {% block footer %}
            <span>Data collected via the OpenRouter API.</span>
            <span><a href="{{ nav_prefix }}methodology.html">Methodology</a> · <a href="https://github.com/timothee-chauvin/trackllm_website">GitHub</a> · <a href="{{ nav_prefix }}about.html">About</a></span>
            {% endblock %}
        </footer>
    </div>
    {{ cite_dialog() }}
    {% block scripts %}{% endblock %}
    <script type="module" src="{{ nav_prefix }}js/copy_llm.js"></script>
    <script>
    (function () {
        var root = document.documentElement;
        var btn = document.getElementById('themeToggle');
        function label(theme) { return theme === 'dark' ? '☀' : '☾'; }
        function effectiveTheme() {
            return root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        }
        if (btn) {
            btn.textContent = label(effectiveTheme());
            btn.addEventListener('click', function () {
                var next = effectiveTheme() === 'dark' ? 'light' : 'dark';
                root.dataset.theme = next;
                localStorage.setItem('theme', next);
                btn.textContent = label(next);
            });
        }
    })();
    (function () {
        var dlg = document.getElementById('citeDialog');
        document.querySelectorAll('.cite-pill').forEach(function (p) {
            p.addEventListener('click', function () { dlg.showModal(); });
        });
        dlg.querySelector('.cite-dialog-close').addEventListener('click', function () { dlg.close(); });
        dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
        function bindCopy(el, text) {
            function copy() {
                navigator.clipboard.writeText(text()).then(function () {
                    el.classList.add('is-copied');
                    setTimeout(function () { el.classList.remove('is-copied'); }, 1500);
                });
            }
            el.addEventListener('click', copy);
            if (el.tagName !== 'BUTTON') el.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); copy(); }
            });
        }
        dlg.querySelectorAll('.cite-box').forEach(function (box) {
            bindCopy(box, function () { return box.querySelector('.cite-copyable').textContent.trim(); });
        });
        document.querySelectorAll('.copy-bib').forEach(function (b) {
            bindCopy(b, function () { return b.dataset.bibtex; });
        });
    })();
    </script>
    <!-- Privacy-friendly analytics with https://www.goatcounter.com -->
    <script data-goatcounter="https://trackllm.goatcounter.com/count" async src="//gc.zgo.at/count.v5.js"
      crossorigin="anonymous" integrity="sha384-atnOLvQb9t+jTSipvd75X2yginT4PjVbqDdlJAmxMm+wYElFmeR6EmLP5bYeoRVQ"></script>
</body>
</html>
