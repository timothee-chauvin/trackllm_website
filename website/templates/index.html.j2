{% extends "base.html.j2" %}
{% from "_macros.html.j2" import affiliations, cite_pill, subscribe_pill, more_link, dir_table %}
{% block title %}TrackLLM{% endblock %}
{% block content %}
<header class="hero">
  <svg class="hero-trace" id="heroTrace" preserveAspectRatio="none" viewBox="0 0 1200 300"></svg>
  <svg class="hero-hit-layer" id="heroHit" preserveAspectRatio="none"></svg>
  <div class="hero-tip" id="heroTip" hidden></div>
  <div class="wrap hero-inner">
    <div class="eyebrow" id="eyebrow"><span class="dot"></span></div>
    <h1 class="title">LLM API outputs are <em>unstable</em> over time.</h1>
    <p class="lede">LLM APIs are opaque black boxes, even for open-weight models. TrackLLM continuously monitors them for <b>undisclosed changes</b> — cheaply — with <b>logprob tracking</b> (LT) where logprobs are exposed, and <b>black-box border input tracking</b> (B3IT) where they aren't. Small changes are fine, but they should be disclosed.</p>
    <div class="telemetry" id="telemetry"></div>
    <p class="fresh" id="freshness"></p>
    {{ affiliations() }}
    <div class="hero-pills">{{ cite_pill() }} {{ subscribe_pill(machine, nav_prefix) }}</div>
  </div>
</header>

<main class="wrap">
  {# Each section is a slice of a page of its own: the heading links there, and
     so do the "All …" link at the head's right edge and the More button under
     the block. #}
  <section class="block">
    <div class="sec-head">
      <h2><a href="changes.html">Latest changes</a></h2>
      <span class="hint">how far each endpoint moved from its baseline — LT's σ is the detection score, not a size; see <a href="methodology.html#detection">how a change is called</a></span>
      <a class="more" href="changes.html" id="allChanges"></a>
    </div>
    <div class="feed" id="feed"></div>
    {{ more_link("changes.html", "the full changelog") }}
  </section>

  <section class="block">
    <div class="sec-head">
      <h2><a href="providers.html">Providers</a></h2>
      <span class="hint">detected changes per <b>endpoint-year</b> of LT monitoring — normalized for fleet size &amp; monitoring length — with a 95% Poisson interval. The most drift-prone providers; each is a company with its serving variants (fp8, fp4, …) pooled</span>
      <a class="more" href="providers.html" id="allProviders"></a>
    </div>
    <div class="panel rplot" id="provPlot"></div>
    {{ more_link("providers.html", "every provider") }}
  </section>

  <section class="block">
    <div class="sec-head">
      <h2><a href="endpoints.html">Endpoints</a></h2>
      <span class="hint" id="dirCount"></span>
      <a class="more" href="endpoints.html">All endpoints →</a>
    </div>
    {{ dir_table(sortable=false) }}
    {{ more_link("endpoints.html", "all endpoints") }}
  </section>

</main>
{% endblock %}

{% block scripts %}
    <script type="module" src="js/overview.js?v={{ ASSET_V }}"></script>
{% endblock %}
