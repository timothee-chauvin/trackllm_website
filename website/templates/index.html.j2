{% extends "base.html.j2" %}
{% from "_macros.html.j2" import chip, search_box, affiliations, cite_pill %}
{% block title %}TrackLLM{% endblock %}
{% block content %}
<header class="hero">
  <svg class="hero-trace" id="heroTrace" preserveAspectRatio="none" viewBox="0 0 1200 300"></svg>
  <svg class="hero-hit-layer" id="heroHit" preserveAspectRatio="none"></svg>
  <div class="hero-tip" id="heroTip" hidden></div>
  <div class="wrap hero-inner">
    <div class="eyebrow" id="eyebrow"><span class="dot"></span></div>
    <h1 class="title">LLM API outputs are <em>unstable</em> over time.</h1>
    <p class="lede">LLM APIs are opaque black boxes, even for open-weight models. TrackLLM continuously monitors them for <b>undisclosed changes</b> — cheaply — with <b>logprob tracking</b> (LT) where logprobs are exposed, and <b>black-box border input tracking</b> (B3IT) where they aren't. Small changes are fine, but they should be disclosed.</p>
    <div class="telemetry" id="telemetry"></div>
    <p class="fresh" id="freshness"></p>
    {{ affiliations() }}
    {{ cite_pill() }}
  </div>
</header>

<main class="wrap">
  <section class="block">
    <div class="sec-head">
      <h2>Latest detected changes</h2>
      <span class="hint">sparkline is the endpoint's drift around the changepoint (dashed): LT tracks how far the returned logprob averages have moved from the reference period (nats; the headline number is the shift in that level at the change); B3IT the total-variation shift of border-input outputs (0–1)</span>
      <a class="more" href="changes.html">Full changelog →</a>
    </div>
    <div class="feed" id="feed"></div>
  </section>

  <section class="block">
    <div class="sec-head">
      <h2>Providers</h2>
      <span class="hint">detected changes per <b>endpoint-year</b> of monitoring — normalized for fleet size &amp; monitoring length — with a 95% Poisson interval. Providers are grouped by company; their serving variants (fp8, fp4, …) are compared on the provider page</span>
    </div>
    <div class="boards" id="provBoards"></div>
    <div class="toolbar">
      {{ search_box("provQ", "Search provider…", "Search providers") }}
    </div>
    <div class="table-wrap">
      <div class="table-scroll">
        <table class="dir">
          <thead>
            <tr>
              <th scope="col" data-psort="name">Provider <span class="arr"></span></th>
              <th scope="col" data-psort="n_endpoints" class="r">Endpoints <span class="arr"></span></th>
              <th scope="col" data-psort="lt_rate">LT drift rate (changes / endpoint-year) <span class="arr"></span></th>
              <th scope="col" class="col-hide">Monitoring (1 sq = endpoint-month)</th>
              <th scope="col" class="col-hide">B3IT</th>
              <th scope="col" data-psort="last_change" class="r col-hide">Last change <span class="arr"></span></th>
            </tr>
          </thead>
          <tbody id="provBody"></tbody>
        </table>
      </div>
      <div class="dir-foot" id="provFoot"></div>
    </div>
  </section>

  <section class="block">
    <div class="sec-head">
      <h2>Endpoints</h2>
      <span class="hint" id="dirCount"></span>
    </div>
    <div class="toolbar">
      {{ search_box("q", "Search model, provider, or org…", "Search endpoints by model, provider, or org") }}
      <div class="chips" id="chips">
        {{ chip("Tracked", "st", "tracked", on=true) }}
        {{ chip("Retired", "st", "retired", state="state-retired") }}
        {{ chip("Untrackable", "st", "untrackable") }}
        {{ chip("Too expensive", "st", "too_expensive") }}
        {{ chip("Not selected", "st", "not_selected") }}
        {{ chip("Errors", "st", "errors_out") }}
        {{ chip("Pending", "st", "pending") }}
        {{ chip("Free", "st", "free_excluded") }}
        {{ chip("LT", "f", "lt") }}
        {{ chip("B3IT", "f", "b3it") }}
        {{ chip("Ever changed", "f", "everchanged", state="state-changed") }}
        {{ chip("Recent (60d)", "f", "recent", state="state-changed") }}
      </div>
    </div>
    <div class="table-wrap">
      <div class="table-scroll">
        <table class="dir">
          <thead>
            <tr>
              <th scope="col" data-sort="model">Model <span class="arr"></span></th>
              <th scope="col" data-sort="provider" class="col-hide">Provider <span class="arr"></span></th>
              <th scope="col" data-sort="status">Status <span class="arr"></span></th>
              <th scope="col" data-sort="nChanges" class="r">Changes <span class="arr"></span></th>
              <th scope="col" class="col-hide">Methods</th>
              <th scope="col" data-sort="stableDays" class="r col-hide">Stable for <span class="arr"></span></th>
              <th scope="col" class="col-hide">Drift from baseline</th>
            </tr>
          </thead>
          <tbody id="dirBody"></tbody>
        </table>
      </div>
      <div class="dir-foot" id="dirFoot"></div>
    </div>
  </section>

  <section class="block" id="machine">
    <div class="sec-head">
      <h2>Machine access</h2>
      <span class="hint">for agents, scripts and feed readers — no browser needed</span>
    </div>
    <div class="panel">
      <ul class="prose machine-list">
        <li><b>Markdown mirror</b> — every page has a <code>.md</code> twin at the same path (this one: <a href="index.md">index.md</a>), with the same sections and links to the other <code>.md</code> pages; charts become a link to the JSON they draw. Look for <em>Markdown</em> in any page's footer.</li>
        <li><b>Atom feeds</b> — one entry per detected change: <a href="feeds/all.xml" data-goatcounter-click="subscribe/all">all changes</a>, plus a feed per endpoint, model, provider and organization (<em>Subscribe</em> in that page's footer). Any feed reader works; for email, point an RSS-to-email service at a feed.</li>
        <li><b>JSON</b> — the files these pages are built from: <a href="data/overview.json">overview.json</a>, <a href="data/changes.json">changes.json</a>, <a href="data/changes_page.json">changes_page.json</a>, <a href="data/spend.json">spend.json</a>, <code>data/models/&lt;slug&gt;.json</code>, <code>data/providers/&lt;slug&gt;.json</code>, <code>data/b3it/&lt;slug&gt;/b3it.json</code>; each page's footer links its own.</li>
        <li><b>Raw data</b> — every collected response, committed hourly: <a href="https://github.com/timothee-chauvin/trackllm_data">trackllm_data</a>. The generator: <a href="https://github.com/timothee-chauvin/trackllm_website">trackllm_website</a>.</li>
      </ul>
    </div>
  </section>
</main>
{% endblock %}

{% block scripts %}
    <script type="module" src="js/overview.js"></script>
{% endblock %}
